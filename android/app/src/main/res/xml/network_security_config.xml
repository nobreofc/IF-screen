<?xml version="1.0" encoding="utf-8"?>
<!-- A Central na rede local usa HTTP (IP muda conforme a rede); a nuvem (Railway) usa HTTPS. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
